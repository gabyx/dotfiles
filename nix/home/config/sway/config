# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

# Include default configs.
include /etc/sway/config.d/*

### Variables =================================================================
# Variables can not be included in a `include` file since that does not set the
# parent scopes.

# Main modification key:
# See `programmer` file.
# Use Mod1 for Alt.
# Use Mod2 for Super.
set $mod Mod1

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Your preferred terminal emulator
# ==================================================
set $term gabyx term start
# Start the terminal into a tmux session.
set $term-start gabyx term start-into-tmux
# ==================================================

# Note: pass the final command to swaymsg so that the resulting window can be opened
# on the original workspace that the command was run on.

set $file-manager gabyx windowing file-manager
set $display-manager gabyx windowing display-manager
set $launcher-menu gabyx windowing launcher-menu
set $power-menu gabyx windowing power-menu
set $wireless-menu gabyx windowing wireless-menu
set $network-menu gabyx windowing network-menu
set $bluetooth-menu gabyx windowing bluetooth-menu
set $emoji-menu gabyx windowing emoji-menu
set $systemd-menu gabyx windowing systemd-menu
set $passwdmgr-menu gabyx windowing passwdmgr-menu
set $procs-menu gabyx windowing procs-menu
set $sound-menu gabyx windowing sound-menu
set $calculator-menu gabyx windowing calculator-menu
set $screenshot-menu gabyx windowing screenshot-menu
set $screenrecord-menu gabyx windowing screenrecord-menu
set $color-picker-menu gabyx windowing color-picker-menu
set $clipboard-menu gabyx windowing clipboard-menu

set $brightness-up gabyx windowing brightness-up
set $brightness-down gabyx windowing brightness-down

set $clipboard gabyx windowing clipboard
set $clipboard-menu gabyx windowing clipboard-menu

set $notifications gabyx windowing notifications
set $notification-menu gabyx windowing notification-menu

set $nightshifter gabyx windowing nightshifter

# Special workspaces
# Icons can be found at:
# https://www.nerdfonts.com/cheat-sheet

# Tmux workspaces.
set $ws-1 1:1: 
set $ws-2 2:2: 
set $ws-3 3:3: 
set $ws-4 4:4: 

# Shell workspaces.
set $ws-5 5:5: 
set $ws-6 6:6: 

# Applications workspaces.
set $ws-comm 7:7: 
set $ws-7 7:7: 
set $comm signal-desktop
set $comm-matrix element-desktop
set $comm-slack slack

set $ws-mail 8:8: 
set $ws-8 8:8: 
set $mail evolution

set $ws-web 9:9: 
set $ws-9 9:9: 
set $web zen
set $web-aux firefox

set $ws-creds 10:0: 󱕴
set $ws-10 10:0: 󱕴
set $creds bitwarden
### ===========================================================================

# Generated by Nix (`nix/home/gabyx/windowing/default.nix`):
# includes the conditional files.
include conf

include config-visual
include config-idle
include config-input
include config-keybindings
include config-applications
include config-bar

include config-startup
